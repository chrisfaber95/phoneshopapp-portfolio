# Copy to .env (production build) and .env.development (npm run serve), then fill in.
# Note: VUE_APP_* values are compiled into the browser bundle, so they are visible to every visitor.
# Never put a real secret in a VUE_APP_* variable.

# Base URL of the Server API (with a trailing slash)
VUE_APP_API=
# Used by the store (/api/v2) calls when nobody is logged in
VUE_APP_PUBLIC_API_KEY=
VUE_APP_BAGEAN=

# Copy to .env and fill in. Never commit real values.
# Same variables as the old Server (../Server/.env.example); the NestJS server reads them unchanged.

PORT=3001

# Shop database
DB_HOST=
DB_USER=
DB_PASS=
DB_NAME=

# JWT signing/verifying: must be the same value as the old server so existing tokens keep working
TOKEN_KEY=

# Encrypts order ids in e-mail links: same value as the old server
ORDER_CRYPT_KEY=

# enforce (default) or log: log only writes the requests the access rules would deny to the log
# ACCESS_MODE=enforce

# Folder of the product and discount images, served at /api/back-images/ (default: ./public next to where the server is started)
# IMAGES_DIR=../Server/public

# Where the feedback form is mailed to (default: the shop mailbox, MAIL_USER)
# FEEDBACK_EMAIL=

# Filled in by the modules that need them (mail, Mollie, base URL): see ../Server/.env.example
# BASE_URL=
# MAIL_USER=
# MAIL_PASS=
# MOLLIE_API=
# MOLLIE_TEST_API=
# MOLLIE_WEBHOOK=
# MOLLIE_ACTIE_WEBHOOK=

# BASE_URL=
# MOLLIE_TEST_CARDS=
# PICKUP_FEE=2
# DELIVERY_FEE=3
# ACTIE_ORDER_EMAIL=
# SHOPS_DB_NAME=shops   (use "off" to start without the store site until the shops database exists)
# RECEIPT_SHOP_ID=
# RATE_LIMIT=on         (off switches the rate limits off)
# TRUST_PROXY=1         (number of reverse proxies in front of the server)
# CORS_ORIGINS=https://shop.example.invalid,https://admin.example.invalid   (default: every origin)

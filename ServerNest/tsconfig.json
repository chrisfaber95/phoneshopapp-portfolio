{
  "compilerOptions": {
    "module": "node16",
    "moduleResolution": "node16",
    "target": "ES2022",
    "lib": [
      "ES2022"
    ],
    "strict": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "declaration": false,
    "incremental": true,
    "outDir": "./dist",
    "types": [
      "node",
      "jest"
    ],
    "isolatedModules": true,
    "rootDir": "."
  },
  "include": [
    "src/**/*",
    "test/**/*"
  ]
}

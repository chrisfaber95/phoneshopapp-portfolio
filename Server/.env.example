# Copy to .env and fill in. Never commit real values.

# Server
PORT=3001
BASE_URL=

# Database (config/connection.js, config/connection_store.js)
DB_HOST=
DB_USER=
DB_PASS=
DB_NAME=

# Mail (config/mailing.js)
MAIL_USER=
MAIL_PASS=

# Mollie
MOLLIE_API=
MOLLIE_TEST_API=
MOLLIE_WEBHOOK=
MOLLIE_ACTIE_WEBHOOK=

# Secrets
# JWT signing/verifying (config/authentication.js, routes/middleware/auth.js)
TOKEN_KEY=
# Encrypts order ids in e-mail links. If unset the old built-in key is used (with a warning).
ORDER_CRYPT_KEY=

# Access rules (routes/middleware/access_rules.js): set to "log" to only log the requests that would be denied
# ACCESS_MODE=enforce
